NODE_ENV=development
PORT=8000
API_PREFIX=api/v1

DATABASE_URL=postgresql://user:password@127.0.0.1:5433/ppr_db?schema=public&options=-c%20client_encoding%3DUTF8

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES=365d
JWT_REFRESH_EXPIRES=365d

CORS_ORIGIN=http://localhost:5173

# Socket.io
WS_PATH=/socket.io

# Throttler
THROTTLE_TTL=60000
THROTTLE_LIMIT=500

# Object storage (local disk or Cloudflare R2)
STORAGE_DRIVER=local
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=mppr-uploads
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# OnlyOffice Document Server (browser → localhost:8080, Docker → host.docker.internal)
ONLYOFFICE_SERVER_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=dev-onlyoffice-jwt-secret-change-me
PUBLIC_API_URL=http://host.docker.internal:8000/api/v1
